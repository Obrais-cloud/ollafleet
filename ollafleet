#!/usr/bin/env python3
"""ollafleet — smart proxy making multiple Ollama instances act as one.

Routes each request to the best upstream node for the requested model:
  1. nodes that have the model already loaded (no cold start)  → preferred
  2. nodes that have the model installed                       → fallback
  3. otherwise: round-robin                                     → last resort

Per-node `/api/tags` and `/api/ps` are cached for 30s. Adds an
X-Ollafleet-Node header to every response so you can trace which node served.

  ollafleet serve --nodes http://macstudio:11434,http://corsair:11434 --listen 127.0.0.1:11455
  ollafleet status                # inventory + loaded models per node
"""
from __future__ import annotations
import argparse, json, os, sys, threading, time, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse


HOP = {"connection","keep-alive","proxy-authenticate","proxy-authorization",
       "te","trailers","transfer-encoding","upgrade","content-length"}
CACHE_TTL = 30
_state: dict[str, dict] = {}
_state_lock = threading.Lock()
_rr = 0


def http_json(url: str, timeout=4):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.loads(r.read())
    except Exception:
        return None


def refresh_node(node: str):
    tags = http_json(node + "/api/tags") or {}
    ps = http_json(node + "/api/ps") or {}
    with _state_lock:
        _state[node] = {
            "ts": time.time(),
            "installed": {m["name"] for m in tags.get("models", [])},
            "loaded":    {m["name"] for m in ps.get("models", [])},
        }


def get_state(node: str) -> dict:
    s = _state.get(node)
    if not s or (time.time() - s["ts"]) > CACHE_TTL:
        refresh_node(node)
    return _state.get(node, {"installed": set(), "loaded": set()})


def pick_node(nodes: list[str], model: str | None) -> str:
    global _rr
    if not model:
        node = nodes[_rr % len(nodes)]; _rr += 1; return node
    loaded = [n for n in nodes if model in get_state(n).get("loaded", set())]
    if loaded: return loaded[_rr % len(loaded)]
    installed = [n for n in nodes if model in get_state(n).get("installed", set())]
    if installed:
        node = installed[_rr % len(installed)]; _rr += 1; return node
    node = nodes[_rr % len(nodes)]; _rr += 1
    return node


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def log_message(self, *a): pass
    def do_GET(self):  self._proxy("GET")
    def do_POST(self): self._proxy("POST")
    def do_DELETE(self): self._proxy("DELETE")

    def _proxy(self, method):
        srv = self.server
        n = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(n) if n else b""

        model = None
        if body and self.path.startswith(("/api/", "/v1/")):
            try: model = json.loads(body).get("model")
            except Exception: pass

        node = pick_node(srv.nodes, model)
        up = urlparse(node)
        import http.client
        h = {k:v for k,v in self.headers.items()
             if k.lower() not in HOP and k.lower() != "accept-encoding"}
        h["Host"] = f"{up.hostname}:{up.port or 80}"
        if body: h["Content-Length"] = str(len(body))

        try:
            conn = http.client.HTTPConnection(up.hostname, up.port or 80, timeout=600)
            conn.request(method, self.path, body=body or None, headers=h)
            resp = conn.getresponse()
        except Exception as e:
            b = json.dumps({"error": f"ollafleet: node {node} unreachable: {e}"}).encode()
            self.send_response(502)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(b)))
            self.send_header("X-Ollafleet-Node", node)
            self.end_headers(); self.wfile.write(b); return

        # for /api/ps, /api/tags responses: refresh cache
        ctype = (resp.getheader("Content-Type") or "").lower()
        raw = resp.read()

        self.send_response(resp.status)
        for k,v in resp.getheaders():
            if k.lower() in HOP or k.lower() == "content-length": continue
            self.send_header(k, v)
        self.send_header("X-Ollafleet-Node", node)
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers(); self.wfile.write(raw)


def cmd_serve(a):
    nodes = [n.strip().rstrip("/") for n in a.nodes.split(",") if n.strip()]
    host,_,port = a.listen.rpartition(":")
    httpd = ThreadingHTTPServer((host or "127.0.0.1", int(port)), Handler)
    httpd.nodes = nodes        # type: ignore
    print(f"ollafleet  listen=http://{a.listen}  nodes={len(nodes)}: {nodes}")
    try: httpd.serve_forever()
    except KeyboardInterrupt: print("\nbye")


def cmd_status(a):
    nodes = [n.strip().rstrip("/") for n in (a.nodes or os.environ.get("OLLAFLEET_NODES","")).split(",") if n.strip()]
    if not nodes:
        print("--nodes o $OLLAFLEET_NODES (csv de URLs) requerido", file=sys.stderr); return 1
    for node in nodes:
        refresh_node(node)
        s = _state.get(node)
        if not s:
            print(f"\n{node}  (no responde)"); continue
        print(f"\n{node}  installed={len(s['installed'])}  loaded={len(s['loaded'])}")
        for m in sorted(s["loaded"]):
            print(f"  ● {m}  (loaded — preferred)")
        for m in sorted(s["installed"] - s["loaded"]):
            print(f"  ○ {m}")


def main(argv=None):
    p = argparse.ArgumentParser(prog="ollafleet", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("serve")
    s.add_argument("--nodes", required=False,
                   default=os.environ.get("OLLAFLEET_NODES",""),
                   help="comma-separated upstream URLs ($OLLAFLEET_NODES)")
    s.add_argument("--listen", default=os.environ.get("OLLAFLEET_LISTEN","127.0.0.1:11455"))
    s.set_defaults(f=cmd_serve)
    st = sub.add_parser("status")
    st.add_argument("--nodes", default=None)
    st.set_defaults(f=cmd_status)
    args = p.parse_args(argv)
    if args.cmd == "serve" and not args.nodes:
        p.error("`serve` requiere --nodes o $OLLAFLEET_NODES")
    return args.f(args) or 0


if __name__ == "__main__":
    sys.exit(main())
